# Copy to .env.local and fill in. Everything is optional: with nothing set,
# RecipeFun runs in local mode (data saved in this browser only, no Claude).

# Cooking with Claude + structuring pasted/unstructured recipes.
# Create a key at https://platform.claude.com/ (server-side only; never exposed to the browser).
ANTHROPIC_API_KEY=

# Supabase: accounts, profiles, groups and shared cookbooks.
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Testing only: lets the importer fetch localhost pages. Never set this in production.
# ALLOW_PRIVATE_IMPORTS=1
